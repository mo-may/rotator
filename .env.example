# Standard: ohne Login im internen Netz. Compose veröffentlicht nur auf localhost.
# Optionaler einfacher Browserschutz: Passwort setzen, Benutzername ist dann team.
# Bei Zugriff über ein Netzwerk HTTPS am Reverse Proxy verwenden.
BASIC_AUTH_USER=team
BASIC_AUTH_PASSWORD=

APP_TIMEZONE=Europe/Berlin

# Nur Docker Compose: lokaler Host-Port.
CHOOSER_PORT=8080

# Lokale Ausführung; Compose setzt den Containerpfad selbst.
DATABASE_PATH=./data/chooser.sqlite3
HOST=127.0.0.1
PORT=3000
